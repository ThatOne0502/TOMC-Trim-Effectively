# ---------------------------------------------------------------------------
# TOMC-Trim Effectively
# 目标：公开仓库里只留源码、资源、文档、美术源文件与 wrapper。
# ---------------------------------------------------------------------------

# Gradle
.gradle/
build/
out/
classes/
!gradle/wrapper/gradle-wrapper.jar

# 版本计数器：每次成功构建都会改写，属于本地状态。
build-count.txt

# Fabric / Minecraft 运行目录（runClient / runServer 生成的世界与日志）
run/
logs/
crash-reports/
.fabric/

# 构建产物与本地参考包
*.jar
*.zip
!gradle/wrapper/gradle-wrapper.jar

# 本地备份与临时目录（含解包出来的第三方 mod / 映射中间产物）
backup/
temp/
temp*/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
